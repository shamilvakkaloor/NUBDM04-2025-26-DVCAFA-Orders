rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid))
        && get(/databases/$(database)/documents/editors/$(request.auth.uid)).data.enabled == true;
    }
    function date(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function sub(s) {
      return s is map && s.keys().hasOnly(['t','o','d']) && s.t is string && s.o is string && s.d is bool;
    }
    function valid(d, id) {
      return id.matches('^00[1-9]$') && d.id == id
        && d.keys().hasAll(['id','title','res','owners','summary','status','progress','due','done','link','log','subs','order'])
        && d.keys().hasOnly(['id','title','res','owners','summary','status','progress','due','done','link','log','subs','order','target'])
        && d.title is string && d.title.size() <= 500 && d.summary is string && d.summary.size() <= 5000
        && d.res is string && d.order is string && d.get('target','') is string
        && d.owners is list && d.owners.size() >= 1 && d.owners.size() <= 3
        && d.owners[0] is string && (d.owners.size() < 2 || d.owners[1] is string) && (d.owners.size() < 3 || d.owners[2] is string)
        && d.status in ['todo','prog','done','block']
        && d.progress is int && d.progress >= 0 && d.progress <= 100
        && date(d.due) && date(d.done)
        && d.link is string && d.link.size() <= 2048 && (d.link == '' || d.link.matches('^https?://[^\\s]+$'))
        && d.log is list && d.log.size() <= 200
        && d.subs is list && (d.subs.size() == 0 || (d.subs.size() == 3 && sub(d.subs[0]) && sub(d.subs[1]) && sub(d.subs[2])))
        && (d.status == 'done' ? d.progress == 100 && d.done != '' && (d.subs.size() == 0 || (d.subs[0].d && d.subs[1].d && d.subs[2].d)) : d.done == '' && (d.subs.size() == 0 ? d.progress < 100 : !(d.subs[0].d && d.subs[1].d && d.subs[2].d)))
        && (d.status != 'todo' || (d.progress == 0 && (d.subs.size() == 0 || (!d.subs[0].d && !d.subs[1].d && !d.subs[2].d))));
    }
    function history(previous, next) {
      return next == previous || (next.size() == previous.size() + 1 && next.hasAll(previous)
        && next[next.size()-1].keys().hasOnly(['d','t','by'])
        && date(next[next.size()-1].d) && next[next.size()-1].d != ''
        && next[next.size()-1].t is string && next[next.size()-1].t.size() > 0 && next[next.size()-1].t.size() <= 2000
        && next[next.size()-1].by == request.auth.token.email);
    }
    function sameSubLabels(old, next) {
      return old.size() == next.size() && (old.size() == 0 ||
        (old[0].t == next[0].t && old[0].o == next[0].o && old[1].t == next[1].t && old[1].o == next[1].o && old[2].t == next[2].t && old[2].o == next[2].o));
    }
    match /editors/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /resolutions/{id} {
      // Preserves the original public dashboard. Read access includes every field.
      allow read: if true;
      allow create: if editor() && valid(request.resource.data,id) && request.resource.data.log.size() == 0;
      allow update: if editor() && valid(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','progress','due','done','link','subs','log'])
        && sameSubLabels(resource.data.subs,request.resource.data.subs)
        && history(resource.data.log,request.resource.data.log);
      allow delete: if false;
    }
  }
}
